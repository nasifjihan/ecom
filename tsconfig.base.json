{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Ecom Base TSConfig",
  "compilerOptions": {
    /* Strictness — NON-NEGOTIABLE for junior devs */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": false,

    /* Standard options */
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "preserve",
    "incremental": true,

    /* Path aliases for every workspace package (extend in packages if needed) */
    "baseUrl": ".",
    "paths": {
      "@ecom/shared-types": ["packages/shared-types/src/index.ts"],
      "@ecom/shared-types/*": ["packages/shared-types/src/*"],
      "@ecom/utils": ["packages/utils/src/index.ts"],
      "@ecom/utils/*": ["packages/utils/src/*"],
      "@ecom/zod-schemas": ["packages/zod-schemas/src/index.ts"],
      "@ecom/zod-schemas/*": ["packages/zod-schemas/src/*"],
      "@ecom/api-client": ["packages/api-client/src/index.ts"],
      "@ecom/api-client/*": ["packages/api-client/src/*"],
      "@ecom/ui": ["packages/ui/src/index.ts"],
      "@ecom/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", "build", "coverage"]
}
