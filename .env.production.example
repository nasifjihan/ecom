# ============================================================
#   PRODUCTION settings, for docker-compose.prod.yml (see DEPLOYMENT.md).
#   Copy to `.env` on the server and fill in every <…>. Never commit the filled-in file.
#   The API refuses to start with placeholder secrets, localhost addresses or the local mail
#   catcher, and says which setting to fix.
#   Make each secret with:  openssl rand -hex 32
# ============================================================

NODE_ENV=production
LOG_LEVEL=info

# ----- Images (built by CI on main, in GitHub's registry) -----
GHCR_OWNER=<your GitHub user or organisation, lowercase>
# A git commit (e.g. 1a2b3c4) to pin a version and roll back; "latest" = the newest main.
IMAGE_TAG=latest

# ----- Domains (point their DNS A records at this server) -----
ACME_EMAIL=<you@shop.com>           # for HTTPS certificate notices
SHOP_DOMAIN=<shop.com>              # the main storefront
SHOP_DOMAINS=<shop.com, www.shop.com>   # every storefront domain Caddy serves, comma separated
ADMIN_DOMAIN=<admin.shop.com>
SUPER_DOMAIN=<super.shop.com>
API_DOMAIN=<api.shop.com>

API_PORT=4000
API_BASE_URL=https://<api.shop.com>
COOKIE_DOMAIN=<shop.com>
# Browsers may call the API from these addresses only (your domains, https).
ALLOWED_ORIGINS_REGEX=^https://([a-z0-9-]+\.)?<shop>\.com$
# API docs at /api/docs stay off in production unless this is "on".
API_DOCS=off

# ----- Database (the postgres service) -----
POSTGRES_USER=ecom
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=ecom_platform
DATABASE_URL=postgresql://ecom:<POSTGRES_PASSWORD>@postgres:5432/ecom_platform?schema=public&connection_limit=20
DIRECT_URL=postgresql://ecom:<POSTGRES_PASSWORD>@postgres:5432/ecom_platform

# ----- Redis (the redis service; queues and caches) -----
REDIS_PASSWORD=<openssl rand -hex 24>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

# ----- File storage: an S3-compatible service (Cloudflare R2, DigitalOcean Spaces, AWS S3) -----
STORAGE_DRIVER=s3
S3_ENDPOINT=<https://<account>.r2.cloudflarestorage.com>
S3_REGION=auto
S3_BUCKET=<shop-media>
S3_ACCESS_KEY=<from your storage provider>
S3_SECRET_KEY=<from your storage provider>
S3_FORCE_PATH_STYLE=true
# The bucket's public https address (or your CDN in front of it).
S3_PUBLIC_URL=<https://media.shop.com>

# ----- Secrets: each different, each `openssl rand -hex 32` -----
JWT_ADMIN_ACCESS_SECRET=<…>
JWT_ADMIN_REFRESH_SECRET=<…>
JWT_CUSTOMER_ACCESS_SECRET=<…>
JWT_CUSTOMER_REFRESH_SECRET=<…>
JWT_SUPER_ACCESS_SECRET=<…>
JWT_SUPER_REFRESH_SECRET=<…>
COOKIE_SECRET=<…>
# Encrypts gateway, courier and SMS keys in the database. Back it up: without it they can't be read.
APP_ENCRYPTION_KEY=<openssl rand -hex 32>
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ----- Email (your provider's SMTP: Mailgun, SES, Brevo, …) -----
MAIL_DRIVER=smtp
SMTP_HOST=<smtp.provider.com>
SMTP_PORT=587
SMTP_USER=<…>
SMTP_PASS=<…>
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<no-reply@shop.com>
MAIL_FROM_NAME=<Shop name>
EMAIL_QUEUE=bullmq

# ----- First start only (pnpm bootstrap, see DEPLOYMENT.md); remove after -----
BOOTSTRAP_EMAIL=<you@shop.com>
BOOTSTRAP_PASSWORD=<at least 12 characters, letters and numbers>

# Payment gateways, couriers, SMS and WhatsApp keys are entered per store in the admin
# (Settings), encrypted in the database. Nothing to set here.
