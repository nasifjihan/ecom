# ============================================================
# E-Commerce Platform — Environment Variables SKELETON
# Copy this file to `.env` at project root BEFORE running anything.
# Fill in secrets — NEVER commit `.env` to git (it is gitignored).
# ============================================================

# ===== BASIC =====
NODE_ENV=development
LOG_LEVEL=debug

# ===== API =====
API_PORT=4000
API_BASE_URL=http://localhost:4000
COOKIE_DOMAIN=.local-ecom.dev

# ===== DATABASE (PostgreSQL via Docker Compose) =====
DATABASE_URL="postgresql://ecom:ecom_local_pw@localhost:5432/ecom_platform?schema=public&connection_limit=20&pool_timeout=0"
DIRECT_URL="postgresql://ecom:ecom_local_pw@localhost:5432/ecom_platform"

# ===== REDIS (via Docker Compose) =====
REDIS_URL="redis://localhost:6379/0"

# ===== STORAGE (S3-compatible — MinIO via Docker locally) =====
STORAGE_DRIVER=s3                      # s3 | local
STORAGE_LOCAL_PATH="./storage/files"
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ecom-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/ecom-local

# ===== AUTH / TOKENS =====
# 🔐 Use `openssl rand -hex 32` to generate new random secrets before production.
JWT_ADMIN_ACCESS_SECRET=replace_me_admin_access
JWT_ADMIN_REFRESH_SECRET=replace_me_admin_refresh
JWT_CUSTOMER_ACCESS_SECRET=replace_me_customer_access
JWT_CUSTOMER_REFRESH_SECRET=replace_me_customer_refresh
JWT_SUPER_ACCESS_SECRET=replace_me_super_access
JWT_SUPER_REFRESH_SECRET=replace_me_super_refresh
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECRET=replace_me_cookie_sig
# Encrypt secrets stored in DB (AES-256-GCM — needs EXACTLY 32 bytes / 64 hex chars):
APP_ENCRYPTION_KEY=replace_me_exactly_64_hex_chars_longer!

# ===== EMAIL (SMTP — defaults to Mailpit in docker-compose) =====
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_ENCRYPTION=none
MAIL_FROM_ADDRESS="no-reply@local-ecom.dev"
MAIL_FROM_NAME="Local Ecom Store"
# Emails go through the BullMQ queue in Redis (bullmq) or are sent straight away (inline).
EMAIL_QUEUE=bullmq
# The API sends queued emails itself. Set to off when running `pnpm worker` separately.
EMAIL_WORKER=on

# ===== SMS (optional) =====
SMS_DRIVER=none                     # none | twilio | sslwireless
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SSLWIRELESS_API_TOKEN=
SSLWIRELESS_SID=

# ===== PAYMENTS =====
# Online payments: each store enters its own bKash / SSLCommerz keys in the admin.
# These only point the API at another base URL (a local mock); leave blank for the real gateways.
BKASH_API_URL=
SSLCOMMERZ_API_URL=

# ===== SHIPPING =====
PATHAO_MODE=sandbox
PATHAO_API_URL=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
STEADFAST_API_KEY=
STEADFAST_BASE_URL=
# Courier API base URLs are only for pointing at a test server; leave empty for the real APIs.
# Local mock: `pnpm --filter @ecom/api couriers:mock`, then
#   STEADFAST_BASE_URL=http://localhost:4010/steadfast/api/v1
#   PATHAO_API_URL=http://localhost:4010/pathao
#   REDX_API_URL=http://localhost:4010/redx
REDX_API_URL=
# How often booked parcels are checked with their courier (minutes, 0 = never; webhooks still work)
COURIER_SYNC_MINUTES=30
# SMS keys are set per store in the admin (Settings → SMS). These base URLs are only for pointing
# at a test server; leave empty for the real APIs. Local mock: `pnpm --filter @ecom/api sms:mock`, then
#   BULKSMSBD_API_URL=http://localhost:4011/bulksmsbd
#   ALPHASMS_API_URL=http://localhost:4011/alphasms
#   SSLWIRELESS_API_URL=http://localhost:4011/sslwireless
BULKSMSBD_API_URL=
ALPHASMS_API_URL=
SSLWIRELESS_API_URL=
REDSMS_API_KEY=
SUNDARBAN_API_KEY=
PAPERFLY_API_KEY=
DHL_CLIENT_ID=
DHL_CLIENT_SECRET=
FEDEX_API_KEY=

# ===== PLATFORM (Super Admin) =====
PLATFORM_WEBHOOK_SECRET=
PLATFORM_SUBDOMAIN_SUFFIX=.yourplatform.com

# ===== CORS =====
ALLOWED_ORIGINS_REGEX="^https?://(localhost|127\.0\.0\.1|.*\.local)(:\d+)?$"
