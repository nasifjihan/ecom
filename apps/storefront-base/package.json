    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "sonner": "^1.5.0",
    "swiper": "^11.1.14",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "@ecom/shared-types": "workspace:*",
    "@ecom/utils": "workspace:*",
    "@ecom/zod-schemas": "workspace:*",
    "@ecom/api-client": "workspace:*",
    "@ecom/ui": "workspace:*",
    "lucide-react": "^0.441.0",
    "framer-motion": "^11.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.5",
