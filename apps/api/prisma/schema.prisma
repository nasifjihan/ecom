// ============================================================
// WAREHOUSES (Batch 29)
// ============================================================

/// A place stock is kept. Every store has one default warehouse; online orders ship from it unless
/// another one has everything the order needs.
model Warehouse {
  id           BigInt           @id @default(autoincrement())
  storeId      BigInt
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  /// Short code shown on lists and stock logs, e.g. "MAIN", "CTG".
  code         String
  address      String?
  phone        String?
  isDefault    Boolean          @default(false)
  isActive     Boolean          @default(true)
  sortOrder    Int              @default(0)
  stock        WarehouseStock[]
  orders       Order[]
  shipments    Shipment[]
  purchases    Purchase[]
  transfersOut StockTransfer[]  @relation("TransferFrom")
  transfersIn  StockTransfer[]  @relation("TransferTo")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

/// Stock of one product (no options) or one option in one warehouse. The product's and option's
/// stockQty / reservedStock are the totals over all warehouses (kept in step by the stock ledger).
model WarehouseStock {
  id          BigInt          @id @default(autoincrement())
  storeId     BigInt
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouseId BigInt
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   BigInt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   BigInt?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// "p<productId>" or "v<variantId>", so a product without options has one row per warehouse.
  skuKey      String
  /// Units on the shelf.
  onHand      Int             @default(0)
  /// Units held for orders not yet packed.
  reserved    Int             @default(0)
  /// Shelf / bin location, e.g. "A-3-2".
  bin         String?
  updatedAt   DateTime        @updatedAt

  @@unique([warehouseId, skuKey])
  @@index([storeId, productId])
}

/// Stock sent from one warehouse to another. Sending takes it out of the source at once; receiving
/// adds what arrived, and anything missing is written off as a shortfall.
model StockTransfer {
  id                BigInt              @id @default(autoincrement())
  storeId           BigInt
  store             Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// TR-0001
  code              String
  fromWarehouseId   BigInt
  fromWarehouse     Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId     BigInt
  toWarehouse       Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  /// in_transit | received | cancelled
  status            String              @default("in_transit")
  note              String?
  receivedNote      String?
  items             StockTransferItem[]
  sentByAdminId     BigInt?
  receivedByAdminId BigInt?
  sentAt            DateTime            @default(now())
  receivedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([storeId, code])
  @@index([storeId, status])
}

model StockTransferItem {
  id          BigInt          @id @default(autoincrement())
  transferId  BigInt
  transfer    StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   BigInt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   BigInt?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  name        String
  sku         String?
  qtySent     Int
  /// Set on receipt; qtySent - qtyReceived is the shortfall.
  qtyReceived Int?
}

// ============================================================
// LOYALTY, WALLET AND REFERRALS (Batch 30)
// ============================================================

/// One per store: cashback, wallet use at checkout, and the refer-a-friend rewards.
model LoyaltySettings {
  id                  BigInt   @id @default(autoincrement())
  storeId             BigInt   @unique
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Customers can pay part or all of an order from their wallet.
  walletEnabled       Boolean  @default(true)
  /// Most of an order's total the wallet may pay, in %.
  walletMaxPercent    Decimal  @default(100) @db.Decimal(5, 2)
  cashbackEnabled     Boolean  @default(false)
  /// % of the items (after discounts) credited to the wallet when an order is delivered.
  cashbackPercent     Decimal  @default(0) @db.Decimal(5, 2)
  cashbackMinOrder    Decimal  @default(0) @db.Decimal(12, 2)
  /// Largest cashback on one order (null = no limit).
  cashbackMaxPerOrder Decimal? @db.Decimal(12, 2)
  levelsEnabled       Boolean  @default(false)
  referralEnabled     Boolean  @default(false)
  /// Wallet credit for the customer who shared the link, when the friend's first order is delivered.
  referrerReward      Decimal  @default(0) @db.Decimal(12, 2)
  /// Wallet credit for the new customer on that same first order.
  refereeReward       Decimal  @default(0) @db.Decimal(12, 2)
  /// The friend's first order must be at least this (items after discounts).
  referralMinOrder    Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt           DateTime @updatedAt
}

/// Bronze / Silver / Gold…: reached by spend on delivered orders; gives a discount and extra cashback.
model LoyaltyLevel {
  id              BigInt     @id @default(autoincrement())
  storeId         BigInt
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  /// Spend (items less discounts and refunds, delivered orders) needed to reach it.
  minSpend        Decimal    @db.Decimal(14, 2)
  /// Off the items at checkout, after promotions and coupons.
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  /// Added to the store's cashback %.
  cashbackPercent Decimal    @default(0) @db.Decimal(5, 2)
  color           String?
  customers       Customer[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([storeId, name])
}

/// The wallet ledger: every credit and debit; Customer.storeCredit is the running balance.
model WalletTransaction {
  id               BigInt   @id @default(autoincrement())
  storeId          BigInt
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId       BigInt
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// + in, − out
  amount           Decimal  @db.Decimal(12, 2)
  /// cashback | cashback_reversed | order_payment | order_payment_returned | refund | referral | adjustment
  kind             String
  orderId          BigInt?
  note             String?
  balanceAfter     Decimal  @db.Decimal(12, 2)
  createdByAdminId BigInt?
  createdAt        DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([storeId, kind])
}

// ============================================================ WHOLESALE / B2B (Batch 33)

/// Whether the shop sells to businesses, and how applications are handled.
model WholesaleSettings {
  id          BigInt   @id @default(autoincrement())
  storeId     BigInt   @unique
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Customers can apply for a business account; approved accounts get business prices.
  enabled     Boolean  @default(false)
  /// Approve applications straight away instead of waiting for staff.
  autoApprove Boolean  @default(false)
  /// Shown above the application form (what businesses get, who qualifies).
  intro       String?
  updatedAt   DateTime @updatedAt
}

/// A customer's business account: applied for on the storefront, reviewed by staff.
model BusinessAccount {
  id             BigInt    @id @default(autoincrement())
  storeId        BigInt
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId     BigInt    @unique
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  companyName    String
  /// retailer | reseller | corporate | institution | other
  businessType   String    @default("retailer")
  contactPhone   String?
  address        String?
  tradeLicenseNo String?
  /// VAT registration (BIN).
  vatRegNo       String?
  /// What the applicant told us (what they sell, expected volume).
  note           String?
  /// PENDING | APPROVED | REJECTED | SUSPENDED
  status         String    @default("PENDING")
  /// Staff's reason, shown to the customer when rejected or suspended.
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedById   BigInt?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, status])
}

/// Bulk price: buy at least `minQty` of a product (or one of its options) and each costs `price`.
model PriceTier {
  id          BigInt          @id @default(autoincrement())
  storeId     BigInt
  productId   BigInt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// null = the product itself, or every option that has no tiers of its own.
  variantId   BigInt?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQty      Int
  price       Decimal         @db.Decimal(12, 2)
  /// false = approved business accounts only; true = any shopper buying that many.
  forEveryone Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([productId])
}

/// A price offer to one customer: staff draft it (or the customer asks from their cart), send it,
/// the customer accepts or declines, and staff turn it into an order at the quoted prices.
model Quotation {
  id           BigInt          @id @default(autoincrement())
  storeId      BigInt
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Q-000001, per store.
  number       String
  customerId   BigInt
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The storefront the order will be for (null: the default one).
  storefrontId BigInt?
  /// REQUESTED | DRAFT | SENT | ACCEPTED | DECLINED | ORDERED | CANCELLED (a SENT quote past validUntil reads as expired)
  status       String          @default("DRAFT")
  validUntil   DateTime?
  /// What the customer wrote when asking, accepting or declining.
  customerNote String?
  /// Shown to the customer (payment terms, delivery time…).
  terms        String?
  /// Staff only.
  staffNote    String?
  /// Taken off the items (fixed amount).
  discount     Decimal         @default(0) @db.Decimal(12, 2)
  /// Delivery charge agreed; carried into the order as a fee staff typed.
  deliveryFee  Decimal         @default(0) @db.Decimal(12, 2)
  subtotal     Decimal         @default(0) @db.Decimal(14, 2)
  total        Decimal         @default(0) @db.Decimal(14, 2)
  orderId      BigInt?         @unique
  sentAt       DateTime?
  respondedAt  DateTime?
  createdById  BigInt?
  items        QuotationItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([storeId, number])
  @@index([storeId, status])
  @@index([customerId])
}

model QuotationItem {
  id          BigInt    @id @default(autoincrement())
  quotationId BigInt
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   BigInt?
  variantId   BigInt?
  name        String
  option      String?
  sku         String?
  qty         Int
  /// The quoted price each.
  unitPrice   Decimal   @db.Decimal(12, 2)
  /// What the customer would pay without the quote (for "you save").
  listPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  sortOrder   Int       @default(0)

  @@index([quotationId])
}

// ============================================================ SALES TEAM COMMISSION (Batch 33)

model SalesSettings {
  id          BigInt   @id @default(autoincrement())
  storeId     BigInt   @unique
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  /// Commission on products with no product or category rate, in %.
  defaultRate Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt   DateTime @updatedAt
}

/// A salesperson's commission on one order, worked out when the order was credited to them.
/// Whether it's earned is read from the order: delivered and paid, less refunds; nothing if cancelled.
model SalesCommission {
  id            BigInt    @id @default(autoincrement())
  storeId       BigInt
  orderId       BigInt    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  salespersonId BigInt
  salesperson   AdminUser @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  /// Items after discounts the commission is on.
  base          Decimal   @db.Decimal(14, 2)
  amount        Decimal   @db.Decimal(12, 2)
  /// Per line: name, base, rate and where the rate came from.
  lines         Json
  paidOutAt     DateTime?
  paidOutById   BigInt?
  createdAt     DateTime  @default(now())

  @@index([storeId, salespersonId])
}

/// Sales a salesperson aims for in a month (items after discounts on delivered, paid orders).
model SalesTarget {
  id            BigInt    @id @default(autoincrement())
  storeId       BigInt
  salespersonId BigInt
  salesperson   AdminUser @relation(fields: [salespersonId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month         String
  amount        Decimal   @db.Decimal(14, 2)

  @@unique([salespersonId, month])
}

// ============================================================ REDIRECTS (Batch 33)

/// Send visitors of an old address to a new one (after a product, category or page changed its URL).
model Redirect {
  id         BigInt    @id @default(autoincrement())
  storeId    BigInt
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// "/old-path", lowercase, no trailing slash, no query.
  fromPath   String
  /// "/new-path" on this shop, or a full https:// address.
  toUrl      String
  /// 301 (moved for good) or 302 (for now).
  statusCode Int       @default(301)
  isActive   Boolean   @default(true)
  /// Made automatically when something's web address changed.
  auto       Boolean   @default(false)
  note       String?
  hits       Int       @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([storeId, fromPath])
}

/// Addresses visitors asked for that don't exist (to fix with a redirect).
model NotFoundHit {
  id        BigInt   @id @default(autoincrement())
  storeId   BigInt
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  path      String
  hits      Int      @default(1)
  referrer  String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@unique([storeId, path])
  @@index([storeId, lastSeen])
}

// ============================================================ LANDING PAGES (Batch 33)

/// A page for one product (ads, Facebook posts) at /lp/{slug}: hero, blocks, reviews and an order form.
model LandingPage {
  id           BigInt    @id @default(autoincrement())
  storeId      BigInt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  /// draft | published
  status       String    @default("draft")
  productId    BigInt
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  headline     String
  subheadline  String?
  /// Empty: the product's first image.
  heroImageUrl String?
  /// Price each on this page (every option); empty: the normal price.
  offerPrice   Decimal?  @db.Decimal(12, 2)
  /// The offer price stops then (a countdown shows until it); empty: no end.
  offerEndsAt  DateTime?
  /// Page blocks (the page builder's sections) shown between the hero and the order form.
  sections     Json      @default("[]")
  showReviews  Boolean   @default(true)
  ctaText      String    @default("Order now")
  formTitle    String?
  maxQty       Int       @default(10)
  seoTitle     String?
  metaDesc     String?
  views        Int       @default(0)
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, slug])
}

/// A festival or shopping day on the store's calendar (Marketing > Festival calendar), with
/// its sale window, a prep checklist and the campaigns set up for it. Days are Dhaka dates.
model Festival {
  id             BigInt    @id @default(autoincrement())
  storeId        BigInt
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Built-in festival it came from (eid_ul_fitr, pohela_boishakh …); null for the store's own.
  key            String?
  name           String
  startsOn       DateTime  @db.Date
  endsOn         DateTime  @db.Date
  saleFrom       DateTime  @db.Date
  saleTo         DateTime  @db.Date
  /// Moon-sighted dates: estimates until announced.
  dateIsEstimate Boolean   @default(false)
  /// Email the team this many days before the sale starts.
  remindDays     Int       @default(14)
  remindedAt     DateTime?
  note           String?
  /// [{ id, text, done }]
  checklist      Json      @default("[]")
  promotionIds   BigInt[]  @default([])
  flashSaleIds   BigInt[]  @default([])
  couponIds      BigInt[]  @default([])
  landingPageIds BigInt[]  @default([])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([storeId, startsOn])
}

/// A gift box shoppers fill themselves (Catalog > Gift boxes, /gift-boxes/{slug}). The box is a
/// product (the packaging: its price, stock and styles as options); what goes in it is sold as
/// ordinary lines tagged with the box (OrderItem.meta.giftBox), checked at checkout.
model GiftBox {
  id           BigInt   @id @default(autoincrement())
  storeId      BigInt
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug         String
  name         String
  description  String?
  imageUrl     String?
  boxProductId BigInt
  boxProduct   Product  @relation(fields: [boxProductId], references: [id], onDelete: Restrict)
  minItems     Int      @default(2)
  maxItems     Int      @default(6)
  /// What it takes: these products and anything in these categories (both empty: any product).
  productIds   BigInt[] @default([])
  categoryIds  BigInt[] @default([])
  allowMessage Boolean  @default(true)
  messageMax   Int      @default(200)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, slug])
}
