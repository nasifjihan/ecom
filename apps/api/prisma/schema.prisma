// ============================================================
// PROVIDER & DATASOURCE
// ============================================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// PLATFORM / SUPER-ADMIN LEVEL (NO storeId)
// ============================================================

enum PlanType {
  BASIC
  PRO
  ENTERPRISE
}

model Plan {
  id           BigInt                @id @default(autoincrement())
  name         String                @unique
  type         PlanType
  priceMonthly Decimal               @db.Decimal(12, 2)
  priceYearly  Decimal               @db.Decimal(12, 2)
  features     Json
  stores       Store[]
  billingSubs  BillingSubscription[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model BillingSubscription {
  id                BigInt    @id @default(autoincrement())
  storeId           BigInt    @unique
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId            BigInt
  plan              Plan      @relation(fields: [planId], references: [id])
  externalId        String?   @unique
  status            String
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Store {
  id          BigInt               @id @default(autoincrement())
  name        String
  slug        String               @unique
  planId      BigInt?
  plan        Plan?                @relation(fields: [planId], references: [id])
  status      String               @default("active")
  trialEndsAt DateTime?
  billingSub  BillingSubscription?

  domains              Domain[]
  admins               AdminUser[]
  generalSettings      StoreGeneralSetting?
  brandSettings        StoreBrandSetting?
  layoutSettings       StoreLayoutSetting?
  paymentSettings      PaymentGatewayConfig[]
  shippingZones        ShippingZone[]
  shipments            Shipment[]
  paymentRecords       PaymentRecord[]
  paymentAttempts      PaymentAttempt[]
  paymentEvents        PaymentEvent[]
  idempotencyKeys      IdempotencyKey[]
  courierSettlements   CourierSettlement[]
  courierAccounts      CourierAccount[]
  locationsOff         StoreLocationOff[]
  taxClasses           TaxClass[]
  emailSettings        StoreEmailSetting?
  seoSettings          StoreSeoSetting?
  securitySettings     StoreSecuritySetting?
  localizationSettings StoreLocalizationSetting?

  products             Product[]
  categories           Category[]
  brands               Brand[]
  attributes           Attribute[]
  collections          Collection[]
  customerGroups       CustomerGroup[]
  customers            Customer[]
  reviews              Review[]
  orders               Order[]
  refunds              Refund[]
  returns              ReturnRequest[]
  coupons              Coupon[]
  promotions           Promotion[]
  smsSetting           StoreSmsSetting?
  smsMessages          SmsMessage[]
  phoneOtps            PhoneOtp[]
  searchTerms          SearchTerm[]
  productQuestions     ProductQuestion[]
  flashSales           FlashSale[]
  giftCards            GiftCard[]
  banners              Banner[]
  pages                CmsPage[]
  blogs                BlogPost[]
  faqs                 Faq[]
  menus                Menu[]
  mediaFolders         MediaFolder[]
  mediaFiles           MediaFile[]
  themes               ThemeConfig[]
  homepageSections     HomepageSection[]
  pageBuilderLayouts   PageBuilderLayout[]
  roles                Role[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  emailTemplates       EmailTemplate[]
  abandonedCarts       AbandonedCart[]
  suppliers            Supplier[]
  purchases            Purchase[]
  supplierPayments     SupplierPayment[]
  moneyAccounts        MoneyAccount[]
  moneyTransactions    MoneyTransaction[]
  qualityGrades        QualityGrade[]
  loyaltySettings      LoyaltySettings?
  wholesaleSettings    WholesaleSettings?
  salesSettings        SalesSettings?
  redirects            Redirect[]
  landingPages         LandingPage[]
  festivals            Festival[]
  giftBoxes            GiftBox[]
  notFoundHits         NotFoundHit[]
  businessAccounts     BusinessAccount[]
  quotations           Quotation[]
  loyaltyLevels        LoyaltyLevel[]
  walletTransactions   WalletTransaction[]
  warehouses           Warehouse[]
  storefronts          Storefront[]
  productStorefronts   ProductStorefront[]
  warehouseStock       WarehouseStock[]
  stockTransfers       StockTransfer[]
  subscriptionProducts SubscriptionProduct[]
  subscriptions        CustomerSubscription[]
  carts                Cart[]
  affiliates           Affiliate[]
  blogCategories       BlogCategory[]
  digitalDownloads     DigitalDownload[]
  apiIntegrations      ApiIntegration[]
  webhooks             Webhook[]
  currencies           Currency[]
  languages            Language[]
  currencyRateLogs     CurrencyRateLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
}

model Domain {
  id           BigInt      @id @default(autoincrement())
  storeId      BigInt
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  hostname     String      @unique
  type         String
  primary      Boolean     @default(false)
  sslEnabled   Boolean     @default(true)
  /// The storefront this address opens (null: the store's default storefront).
  storefrontId BigInt?
  storefront   Storefront? @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([hostname])
  @@index([storeId])
}

/// One shop front of a store: its own addresses, look, menus, home page, product range and prices.
/// Stock, customers and orders are shared by all of a store's storefronts.
model Storefront {
  id                 BigInt              @id @default(autoincrement())
  storeId            BigInt
  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String
  /// Short code shown on lists, e.g. "MAIN", "KIDS".
  code               String
  /// The storefront used when an address isn't linked to one. Exactly one per store.
  isDefault          Boolean             @default(false)
  isActive           Boolean             @default(true)
  /// Added to every price shown here (negative lowers them), unless a product has its own price.
  priceAdjustPercent Decimal             @default(0) @db.Decimal(6, 2)
  /// New products are sold here automatically (otherwise they must be added one by one).
  includeNewProducts Boolean             @default(true)
  /// Payment methods offered here (gateway codes; empty: every enabled one).
  paymentGateways    String[]            @default([])
  /// Courier account suggested when booking this storefront's parcels.
  courierAccountId   BigInt?
  courierAccount     CourierAccount?     @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  sortOrder          Int                 @default(0)
  domains            Domain[]
  menus              Menu[]
  homepageSections   HomepageSection[]
  orders             Order[]
  products           ProductStorefront[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

/// A product in one storefront: whether it's sold there and, optionally, its own price there
/// (which then applies to all of its options). No row means the storefront's default.
model ProductStorefront {
  id            BigInt     @id @default(autoincrement())
  storeId       BigInt
  store         Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId     BigInt
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  storefrontId  BigInt
  storefront    Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  listed        Boolean    @default(true)
  regularPrice  Decimal?   @db.Decimal(12, 2)
  salePrice     Decimal?   @db.Decimal(12, 2)
  /// Own prices per option here, by variant id: { "12": { "regularPrice": 1500, "salePrice": 1300 } }.
  variantPrices Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([productId, storefrontId])
  @@index([storefrontId, listed])
}

model PlatformAdmin {
  id              BigInt    @id @default(autoincrement())
  email           String    @unique
  passwordHash    String
  name            String
  role            String    @default("super_owner")
  twoFactorSecret String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================
// ADMIN USERS, ROLES & PERMISSIONS (PER STORE)
// ============================================================
model Role {
  id                   BigInt                 @id @default(autoincrement())
  storeId              BigInt
  store                Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  isSystem             Boolean                @default(false)
  /// Largest discount (% of the items subtotal) this role may give on an order it creates by hand.
  maxManualDiscountPct Decimal                @default(0) @db.Decimal(5, 2)
  permissions          PermissionAssignment[]
  admins               AdminUser[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([storeId, slug])
}

model PermissionAssignment {
  id         BigInt   @id @default(autoincrement())
  roleId     BigInt
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@index([roleId, permission])
}

model AdminUser {
  id                 BigInt            @id @default(autoincrement())
  storeId            BigInt
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email              String
  passwordHash       String
  name               String
  phone              String?
  avatarUrl          String?
  roleId             BigInt
  role               Role              @relation(fields: [roleId], references: [id])
  status             String            @default("active")
  /// Storefronts this staff member works on (empty: all): their orders, reports and storefront content.
  storefrontIds      BigInt[]          @default([])
  twoFactorSecret    String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  auditLogs          AuditLog[]
  orderStatusLogs    OrderStatusLog[]
  ordersCreated      Order[]           @relation("OrderCreatedBy")
  /// Sales team (Batch 33): earns commission on the orders credited to them.
  isSalesperson      Boolean           @default(false)
  /// Added to the product / category / store rate, in %.
  commissionExtraPct Decimal           @default(0) @db.Decimal(5, 2)
  /// For share links (?sp=CODE): online orders from the link are credited to them.
  salesCode          String?
  ordersSold         Order[]           @relation("OrderSalesperson")
  commissions        SalesCommission[]
  salesTargets       SalesTarget[]
  refunds            Refund[]
  authoredPosts      BlogPost[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([storeId, email])
  @@unique([storeId, salesCode])
}

model AuditLog {
  id         BigInt     @id @default(autoincrement())
  storeId    BigInt
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  adminId    BigInt?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  objectType String
  objectId   String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([storeId, createdAt])
  @@index([adminId])
}

// ============================================================
// STORE SETTINGS (ALL HAVE 1-TO-1 WITH store)
// ============================================================
model StoreGeneralSetting {
  id              BigInt   @id @default(autoincrement())
  storeId         BigInt   @unique
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tagline         String?
  logoUrl         String?
  faviconUrl      String?
  emailFrom       String
  emailFromName   String
  phone           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  countryCode     String?
  timezone        String   @default("Asia/Dhaka")
  dateFormat      String   @default("DD/MM/YYYY")
  weightUnit      String   @default("kg")
  dimensionUnit   String   @default("cm")
  maintenanceMode Boolean  @default(false)
  maintenanceMsg  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StoreBrandSetting {
  id                BigInt   @id @default(autoincrement())
  storeId           BigInt   @unique
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  themeSlug         String   @default("classic")
  colorPrimary      String   @default("#2563eb")
  colorSecondary    String   @default("#64748b")
  colorAccent       String   @default("#f59e0b")
  colorSuccess      String   @default("#10b981")
  colorWarning      String   @default("#f59e0b")
  colorError        String   @default("#ef4444")
  colorBackground   String   @default("#ffffff")
  colorSurface      String   @default("#f8fafc")
  colorText         String   @default("#0f172a")
  colorTextMuted    String   @default("#64748b")
  colorBorder       String   @default("#e2e8f0")
  headingFont       String   @default("Inter")
  bodyFont          String   @default("Inter")
  baseFontSize      Int      @default(16)
  borderRadius      String   @default("md")
  buttonStyle       String   @default("solid")
  cardShadow        String   @default("sm")
  darkModeEnabled   Boolean  @default(false)
  defaultMode       String   @default("light")
  containerMaxWidth Int      @default(1280)
  sectionPaddingY   Int      @default(48)
  sectionPaddingX   Int      @default(16)
  customCss         String?  @db.Text
  customJs          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model StoreLayoutSetting {
  id                           BigInt   @id @default(autoincrement())
  storeId                      BigInt   @unique
  store                        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  headerLogoPosition           String   @default("left")
  headerLayout                 String   @default("v1")
  headerStickyEnabled          Boolean  @default(true)
  headerTransparentHome        Boolean  @default(false)
  headerShowSearch             Boolean  @default(true)
  headerShowWishlist           Boolean  @default(true)
  headerShowCompare            Boolean  @default(true)
  headerShowAccount            Boolean  @default(true)
  headerShowCart               Boolean  @default(true)
  headerShowCurrencySwitcher   Boolean  @default(true)
  headerShowLangSwitcher       Boolean  @default(true)
  headerAnnouncementEnabled    Boolean  @default(false)
  headerAnnouncementText       String?
  headerAnnouncementBg         String?
  headerAnnouncementTextColor  String?
  headerContactPhone           String?
  headerContactEmail           String?
  footerColumns                Int      @default(4)
  footerLayout                 String   @default("v1")
  footerBgColor                String?
  footerTextColor              String?
  footerCopyrightText          String?
  footerShowPaymentIcons       Boolean  @default(true)
  footerShowSocialIcons        Boolean  @default(true)
  footerShowNewsletter         Boolean  @default(true)
  productGridProductsPerRow    Int      @default(4)
  productGridProductsPerPage   Int      @default(12)
  productCardStyle             String   @default("classic")
  productCardShowRating        Boolean  @default(true)
  productCardShowBrand         Boolean  @default(true)
  productCardShowWishlist      Boolean  @default(true)
  productCardShowCompare       Boolean  @default(true)
  productCardShowQuickView     Boolean  @default(true)
  productCardShowBadges        Boolean  @default(true)
  productPageLayout            String   @default("v1")
  productGalleryThumbsPosition String   @default("bottom")
  productShowDescriptionTab    Boolean  @default(true)
  productShowSpecsTab          Boolean  @default(true)
  productShowReviewsTab        Boolean  @default(true)
  productShowFaqTab            Boolean  @default(true)
  productShowSku               Boolean  @default(true)
  productShowBrand             Boolean  @default(true)
  productShowStockCount        Boolean  @default(true)
  productShowBreadcrumbs       Boolean  @default(true)
  productShowSocialShare       Boolean  @default(true)
  productRelatedCount          Int      @default(4)
  productUpsellPosition        String   @default("after_description")
  cartPageLayout               String   @default("standard")
  cartShowCrossSells           Boolean  @default(true)
  cartShowCouponField          Boolean  @default(true)
  checkoutGuestEnabled         Boolean  @default(true)
  checkoutLayout               String   @default("multi_step")
  checkoutShowCompanyField     Boolean  @default(true)
  checkoutShowAddress2Field    Boolean  @default(true)
  checkoutShowOrderNotes       Boolean  @default(true)
  checkoutShowTrustBadges      Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model StoreEmailSetting {
  id             BigInt   @id @default(autoincrement())
  storeId        BigInt   @unique
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  mailer         String   @default("smtp")
  host           String?
  port           Int?
  encryption     String?
  username       String?
  password       String?
  fromAddress    String
  fromName       String
  templateHeader String?  @db.Text
  templateFooter String?  @db.Text
  accentColor    String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// SMS provider and order-SMS settings (modules/sms). Credentials are encrypted JSON.
model StoreSmsSetting {
  id            BigInt    @id @default(autoincrement())
  storeId       BigInt    @unique
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// log (record only, nothing sent) | bulksmsbd | alphasms | sslwireless
  provider      String    @default("log")
  senderId      String?
  credentials   String?
  /// Per event: { enabled, template } (order_placed, order_confirmed, order_shipped, …)
  events        Json?
  /// Customers can sign in with a code sent to their phone.
  phoneOtpLogin Boolean   @default(false)
  lastTestAt    DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Every SMS the store sent or tried to send. One-time codes are stored masked.
model SmsMessage {
  id          BigInt   @id @default(autoincrement())
  storeId     BigInt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  to          String
  body        String
  /// otp | order_placed | order_confirmed | order_shipped | order_delivered | order_cancelled | invoice | test
  kind        String
  orderId     BigInt?
  provider    String
  /// sent | failed | logged
  status      String
  providerRef String?
  error       String?
  segments    Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([storeId, orderId])
}

/// One-time sign-in codes sent by SMS; only a hash of the code is kept.
model PhoneOtp {
  id         BigInt    @id @default(autoincrement())
  storeId    BigInt
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phone      String
  codeHash   String
  purpose    String    @default("login")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([storeId, phone, createdAt])
}

model StoreSeoSetting {
  id                    BigInt   @id @default(autoincrement())
  storeId               BigInt   @unique
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  homeSeoTitle          String?
  homeMetaDescription   String?
  ogImageUrl            String?
  productTitleFormat    String   @default("{product_name} | {store_name}")
  productDescFormat     String   @default("{short_description}")
  categoryTitleFormat   String   @default("{category_name} | {store_name}")
  brandTitleFormat      String   @default("{brand_name} | {store_name}")
  blogTitleFormat       String   @default("{post_title} | {store_name}")
  enableSchemaOrg       Boolean  @default(true)
  autoGenerateCanonical Boolean  @default(true)
  robotsTxt             String?  @db.Text
  googleAnalyticsId     String?
  googleTagManagerId    String?
  facebookPixelId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StoreSecuritySetting {
  id                   BigInt   @id @default(autoincrement())
  storeId              BigInt   @unique
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  adminTwoFaRequired   Boolean  @default(false)
  passwordMinLength    Int      @default(8)
  passwordRequireUpper Boolean  @default(true)
  passwordRequireNum   Boolean  @default(true)
  passwordRequireSym   Boolean  @default(false)
  loginMaxAttempts     Int      @default(5)
  loginLockMinutes     Int      @default(15)
  adminIpWhitelist     Json?
  recaptchaEnabled     Boolean  @default(false)
  recaptchaSiteKey     String?
  recaptchaSecret      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model StoreLocalizationSetting {
  id                BigInt   @id @default(autoincrement())
  storeId           BigInt   @unique
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  defaultCurrency   String   @default("USD")
  allowedCurrencies Json?
  defaultLanguage   String   @default("en")
  allowedLanguages  Json?
  currencyFormat    String   @default("{symbol}{amount}")
  thousandSeparator String   @default(",")
  decimalSeparator  String   @default(".")
  decimals          Int      @default(2)
  enableRtl         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ============================================================
// PAYMENT, SHIPPING, TAX
// ============================================================
model PaymentGatewayConfig {
  id            BigInt    @id @default(autoincrement())
  storeId       BigInt
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  name          String
  description   String?
  enabled       Boolean   @default(false)
  testMode      Boolean   @default(true)
  sortOrder     Int       @default(0)
  credentials   Json?
  /// Online gateways: the merchant API keys, encrypted (config/crypto). Never sent to the browser.
  secrets       String?   @db.Text
  /// Last "Test connection": when, whether it worked, and what the gateway said.
  keysTestedAt  DateTime?
  keysTestOk    Boolean?
  keysTestNote  String?
  instructions  String?   @db.Text
  /// bKash / Nagad / Rocket: "manual" = customers send money to accountNumber and enter the
  /// transaction ID, staff verify it; "online" = the gateway's checkout page.
  mode          String    @default("online")
  accountNumber String?
  /// personal | agent | merchant (how the customer should send: Send Money, Cash Out, Payment)
  accountType   String?
  feeFixed      Decimal   @default(0) @db.Decimal(12, 2)
  feePercent    Decimal   @default(0) @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([storeId, code])
}

model ShippingZone {
  id            BigInt                 @id @default(autoincrement())
  storeId       BigInt
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  countries     Json
  states        Json?
  postcodes     Json?
  enabled       Boolean                @default(true)
  /// Only for these storefronts (empty: all). A storefront's own zones replace shared ones where both cover an address.
  storefrontIds BigInt[]               @default([])
  locations     ShippingZoneLocation[]
  methods       ShippingMethod[]
  orders        Order[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
}

model ShippingMethod {
  id                      BigInt       @id @default(autoincrement())
  zoneId                  BigInt
  zone                    ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code                    String
  name                    String
  description             String?
  enabled                 Boolean      @default(true)
  sortOrder               Int          @default(0)
  baseCost                Decimal      @default(0) @db.Decimal(12, 2)
  perItemCost             Decimal      @default(0) @db.Decimal(12, 2)
  freeFromSubtotal        Decimal?     @db.Decimal(12, 2)
  costRules               Json?
  liveRateConfig          Json?
  taxClassId              BigInt?
  taxClass                TaxClass?    @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  deliveryEstimateMinDays Int?
  deliveryEstimateMaxDays Int?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

/// Bangladesh administrative areas, shared by every store: division -> district -> upazila,
/// plus the Dhaka metro thanas under Dhaka district. Stores can switch delivery off per location.
enum LocationType {
  DIVISION
  DISTRICT
  UPAZILA
  THANA
}

model Location {
  id        BigInt                 @id @default(autoincrement())
  /// Stable key such as "dhaka/dhaka/dhanmondi"; the seed upserts by it.
  code      String                 @unique
  type      LocationType
  nameEn    String
  nameBn    String
  parentId  BigInt?
  parent    Location?              @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Location[]             @relation("LocationTree")
  sortOrder Int                    @default(0)
  zones     ShippingZoneLocation[]
  storesOff StoreLocationOff[]

  @@index([parentId])
  @@index([type])
}

/// A store doesn't deliver to this location (or anywhere under it).
model StoreLocationOff {
  storeId    BigInt
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  locationId BigInt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([storeId, locationId])
}

model ShippingZoneLocation {
  zoneId     BigInt
  zone       ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  locationId BigInt
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([zoneId, locationId])
  @@index([locationId])
}

model TaxClass {
  id              BigInt           @id @default(autoincrement())
  storeId         BigInt
  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  rates           TaxRate[]
  products        Product[]
  shippingMethods ShippingMethod[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model TaxRate {
  id          BigInt   @id @default(autoincrement())
  taxClassId  BigInt
  taxClass    TaxClass @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  countryCode String
  state       String?
  postcode    String?
  city        String?
  rate        Decimal  @db.Decimal(5, 2)
  name        String
  compound    Boolean  @default(false)
  priority    Int      @default(1)

  @@index([taxClassId, countryCode])
}

// ============================================================
// CATALOG
// ============================================================

enum ProductType {
  SIMPLE
  VARIABLE
  DIGITAL
  SUBSCRIPTION
  MADE_TO_ORDER
}

model Category {
  id             BigInt            @id @default(autoincrement())
  storeId        BigInt
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  parentId       BigInt?
  parent         Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]        @relation("CategoryTree")
  imageUrl       String?
  bannerUrl      String?
  description    String?           @db.Text
  /// Sales commission on products in this category, in % (null: the store's default).
  commissionRate Decimal?          @db.Decimal(5, 2)
  displayMode    String            @default("products")
  sortOrder      Int               @default(0)
  isActive       Boolean           @default(true)
  menuIncluded   Boolean           @default(true)
  megaMenuConfig Json?
  seoTitle       String?
  metaDesc       String?
  canonicalUrl   String?
  ogImageUrl     String?
  translations   Json?
  products       ProductCategory[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([storeId, slug, parentId])
  @@index([storeId, isActive])
}

model Brand {
  id           BigInt    @id @default(autoincrement())
  storeId      BigInt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  logoUrl      String?
  bannerUrl    String?
  websiteUrl   String?
  description  String?   @db.Text
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  seoTitle     String?
  metaDesc     String?
  canonicalUrl String?
  ogImageUrl   String?
  translations Json?
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, slug])
}

model Attribute {
  id                BigInt             @id @default(autoincrement())
  storeId           BigInt
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  type              String             @default("select")
  sortOrder         Int                @default(0)
  isFilterable      Boolean            @default(true)
  isActive          Boolean            @default(true)
  terms             AttributeTerm[]
  productAttributes ProductAttribute[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([storeId, slug])
}

model AttributeTerm {
  id                    BigInt                 @id @default(autoincrement())
  attributeId           BigInt
  attribute             Attribute              @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String
  value                 String?
  sortOrder             Int                    @default(0)
  swatchUrl             String?
  productAttributeTerms ProductAttributeTerm[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([attributeId, slug])
}

model Collection {
  id          BigInt              @id @default(autoincrement())
  storeId     BigInt
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  type        String              @default("manual")
  rules       Json?
  imageUrl    String?
  bannerUrl   String?
  description String?             @db.Text
  sortOrder   Int                 @default(0)
  isActive    Boolean             @default(true)
  products    ProductCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([storeId, slug])
}

model Product {
  id                    BigInt                 @id @default(autoincrement())
  storeId               BigInt
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type                  ProductType            @default(SIMPLE)
  name                  String
  slug                  String
  sku                   String?
  barcode               String?
  shortDescription      String?                @db.VarChar(500)
  description           String?                @db.Text
  regularPrice          Decimal?               @db.Decimal(12, 2)
  salePrice             Decimal?               @db.Decimal(12, 2)
  salePriceStartAt      DateTime?
  salePriceEndAt        DateTime?
  manageStock           Boolean                @default(true)
  stockQty              Int?
  reservedStock         Int                    @default(0)
  allowBackorder        Boolean                @default(false)
  lowStockThreshold     Int?
  weight                Decimal?               @db.Decimal(10, 3)
  length                Decimal?               @db.Decimal(10, 3)
  width                 Decimal?               @db.Decimal(10, 3)
  height                Decimal?               @db.Decimal(10, 3)
  /// Where it's made, shown as a badge on the store: "local" (Made in Bangladesh) or "imported"; empty shows none.
  sourcing              String?                @db.VarChar(16)
  /// Country an imported product comes from ("Made in China" on the badge).
  originCountry         String?                @db.VarChar(60)
  brandId               BigInt?
  brand                 Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  taxClassId            BigInt?
  taxClass              TaxClass?              @relation(fields: [taxClassId], references: [id], onDelete: SetNull)
  categories            ProductCategory[]
  storefronts           ProductStorefront[]
  priceTiers            PriceTier[]
  landingPages          LandingPage[]
  giftBoxes             GiftBox[]
  collections           ProductCollection[]
  images                ProductImage[]
  variants              ProductVariant[]
  attributes            ProductAttribute[]
  upsells               ProductLink[]          @relation("Upsells")
  crossSells            ProductLink[]          @relation("CrossSells")
  inventoryLogs         InventoryLog[]
  warehouseStock        WarehouseStock[]
  transferItems         StockTransferItem[]
  reviews               Review[]
  isDigital             Boolean                @default(false)
  digitalFileId         BigInt?
  digitalFile           MediaFile?             @relation("ProductDigitalFile", fields: [digitalFileId], references: [id], onDelete: SetNull)
  downloadLimit         Int?
  downloadExpiryDays    Int?
  virtual               Boolean                @default(false)
  individuallySold      Boolean                @default(false)
  requireShipping       Boolean                @default(true)
  /// draft | published | scheduled | archived (always lowercase; only "published" shows on the storefront)
  status                String                 @default("published")
  /// In the Trash (Catalog > Products > Deleted): hidden everywhere, can be restored.
  deletedAt             DateTime?
  deletedById           BigInt?
  /// The status to go back to when restored from the Trash.
  statusBeforeDelete    String?
  createdById           BigInt?
  updatedById           BigInt?
  featured              Boolean                @default(false)
  allowReviews          Boolean                @default(true)
  seoTitle              String?
  metaDesc              String?
  canonicalUrl          String?
  ogImageUrl            String?
  schemaType            String?
  translations          Json?
  fulfillmentType       String                 @default("own")
  supplierId            BigInt?
  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierCost          Decimal?               @db.Decimal(12, 2)
  /// What one unit cost the shop (average landed cost; purchases update it). Options have their own.
  costPrice             Decimal?               @db.Decimal(12, 2)
  /// Sales commission on this product, in % (null: its category's, else the store's default).
  commissionRate        Decimal?               @db.Decimal(5, 2)
  purchaseItems         PurchaseItem[]
  supplierSku           String?
  averageRating         Decimal                @default(0) @db.Decimal(3, 2)
  /// Search and filter words, lower-case ("eid", "cotton", "gift").
  tags                  String[]               @default([])
  /// [{ group?, label, value }] shown as a table on the product page.
  specifications        Json?
  questions             ProductQuestion[]
  reviewCount           Int                    @default(0)
  viewCount             Int                    @default(0)
  saleCount             Int                    @default(0)
  wishlistItems         WishlistItem[]
  compareItems          CompareItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  flashSaleItems        FlashSaleItem[]
  subscriptionProducts  SubscriptionProduct[]
  customerSubscriptions CustomerSubscription[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, brandId])
  @@index([storeId, type])
  @@index([tags], type: Gin)
  @@index([storeId, deletedAt])
}

model ProductImage {
  id        BigInt     @id @default(autoincrement())
  productId BigInt
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   BigInt?
  media     MediaFile? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  imageUrl  String
  altText   String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([productId, sortOrder])
}

model ProductCategory {
  productId  BigInt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  primary    Boolean  @default(false)

  @@id([productId, categoryId])
}

model ProductCollection {
  productId    BigInt
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId BigInt
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([productId, collectionId])
}

model ProductAttribute {
  id            BigInt                 @id @default(autoincrement())
  productId     BigInt
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId   BigInt
  attribute     Attribute              @relation(fields: [attributeId], references: [id])
  isForVariants Boolean                @default(false)
  terms         ProductAttributeTerm[]

  @@index([productId, attributeId])
}

model ProductAttributeTerm {
  id                 BigInt           @id @default(autoincrement())
  productAttributeId BigInt
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  termId             BigInt
  term               AttributeTerm    @relation(fields: [termId], references: [id])

  @@index([productAttributeId, termId])
}

model ProductVariant {
  id                    BigInt                 @id @default(autoincrement())
  productId             BigInt
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues       Json
  sku                   String?
  barcode               String?
  /// What one unit cost the shop (average landed cost; purchases update it).
  costPrice             Decimal?               @db.Decimal(12, 2)
  purchaseItems         PurchaseItem[]
  regularPrice          Decimal?               @db.Decimal(12, 2)
  salePrice             Decimal?               @db.Decimal(12, 2)
  salePriceStartAt      DateTime?
  salePriceEndAt        DateTime?
  manageStock           Boolean                @default(true)
  stockQty              Int?
  reservedStock         Int                    @default(0)
  allowBackorder        Boolean                @default(false)
  lowStockThreshold     Int?
  imageUrl              String?
  weight                Decimal?               @db.Decimal(10, 3)
  length                Decimal?               @db.Decimal(10, 3)
  width                 Decimal?               @db.Decimal(10, 3)
  height                Decimal?               @db.Decimal(10, 3)
  status                String                 @default("active")
  wishlistItems         WishlistItem[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  flashSaleItems        FlashSaleItem[]
  customerSubscriptions CustomerSubscription[]
  inventoryLogs         InventoryLog[]
  warehouseStock        WarehouseStock[]
  transferItems         StockTransferItem[]
  priceTiers            PriceTier[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([productId, status])
}

model ProductLink {
  id              BigInt  @id @default(autoincrement())
  productId       BigInt
  product         Product @relation("Upsells", fields: [productId], references: [id], onDelete: Cascade)
  linkedProductId BigInt
  linkedProduct   Product @relation("CrossSells", fields: [linkedProductId], references: [id])
  type            String
  sortOrder       Int     @default(0)

  @@index([productId, type])
}

model InventoryLog {
  id          BigInt          @id @default(autoincrement())
  productId   BigInt?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   BigInt?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Warehouse code at the time (kept for old rows); warehouseId is the warehouse itself.
  warehouse   String?
  warehouseId BigInt?
  changeQty   Int
  reason      String
  referenceId String?
  note        String?
  qtyBefore   Int
  qtyAfter    Int
  createdAt   DateTime        @default(now())

  @@index([productId, createdAt])
}

// ============================================================
// CUSTOMERS
// ============================================================

model CustomerGroup {
  id              BigInt     @id @default(autoincrement())
  storeId         BigInt
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  minimumSpend    Decimal?   @db.Decimal(12, 2)
  isSystem        Boolean    @default(false)
  customers       Customer[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Customer {
  id                    BigInt                 @id @default(autoincrement())
  storeId               BigInt
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Optional for customers a shop records by hand (phone, Facebook, walk-in); required to sign in.
  email                 String?
  passwordHash          String?
  firstName             String
  lastName              String
  phone                 String?
  avatarUrl             String?
  isGuest               Boolean                @default(false)
  status                String                 @default("active")
  acceptMarketing       Boolean                @default(false)
  groupId               BigInt?
  group                 CustomerGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  storeCredit           Decimal                @default(0) @db.Decimal(12, 2)
  loyaltyPoints         Int                    @default(0)
  totalSpent            Decimal                @default(0) @db.Decimal(14, 2)
  orderCount            Int                    @default(0)
  twoFactorSecret       String?
  lastLoginAt           DateTime?
  lastLoginIp           String?
  addresses             CustomerAddress[]
  orders                Order[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  compareItems          CompareItem[]
  digitalDownloads      DigitalDownload[]
  giftCardsOwned        GiftCardRedemption[]
  referrals             AffiliateReferral[]    @relation("CustomerReferrals")
  referredByAffiliateId BigInt?
  referredByAffiliate   Affiliate?             @relation("AffiliateReferredCustomers", fields: [referredByAffiliateId], references: [id], onDelete: SetNull)
  subscriptions         CustomerSubscription[]
  carts                 Cart[]
  purchasedGiftCards    GiftCard[]
  returnRequests        ReturnRequest[]
  affiliateProfile      Affiliate?             @relation("CustomerAffiliateProfile")
  /// Loyalty level from qualifyingSpend (Batch 30).
  loyaltyLevelId        BigInt?
  loyaltyLevel          LoyaltyLevel?          @relation(fields: [loyaltyLevelId], references: [id], onDelete: SetNull)
  businessAccount       BusinessAccount?
  quotations            Quotation[]
  /// Items less discounts and refunds over delivered orders; decides the loyalty level.
  qualifyingSpend       Decimal                @default(0) @db.Decimal(14, 2)
  walletTransactions    WalletTransaction[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([storeId, email])
  @@index([storeId, groupId])
  @@index([storeId, status])
}

model CustomerAddress {
  id          BigInt   @id @default(autoincrement())
  customerId  BigInt
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  label       String?
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  state       String?
  upazila     String?
  /// Deepest Location picked (upazila/thana, else district).
  locationId  BigInt?
  postcode    String?
  countryCode String
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([customerId, type])
}

model Review {
  id           BigInt    @id @default(autoincrement())
  storeId      BigInt
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    BigInt
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   BigInt
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId      BigInt?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating       Int
  title        String?
  body         String?   @db.Text
  status       String    @default("approved")
  verified     Boolean   @default(false)
  replyAdminId BigInt?
  replyBody    String?   @db.Text
  replyAt      DateTime?
  mediaIds     Json?
  helpfulCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([productId, status])
  @@index([customerId])
}

/// What customers search for (aggregated per term, not per person). modules/storefront/search.ts
model SearchTerm {
  id             BigInt   @id @default(autoincrement())
  storeId        BigInt
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// Lower-case, single spaces.
  term           String
  searches       Int      @default(1)
  /// Products found the last time it was searched (0 = the shop has nothing for it).
  results        Int      @default(0)
  lastSearchedAt DateTime @default(now())
  createdAt      DateTime @default(now())

  @@unique([storeId, term])
  @@index([storeId, searches])
}

/// Questions customers ask on a product page; shown once staff answer and publish them.
model ProductQuestion {
  id                BigInt    @id @default(autoincrement())
  storeId           BigInt
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId         BigInt
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId        BigInt?
  name              String
  question          String
  answer            String?
  answeredByAdminId BigInt?
  answeredAt        DateTime?
  /// pending | published | hidden
  status            String    @default("pending")
  ip                String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([storeId, status, createdAt])
  @@index([productId, status])
}

model WishlistItem {
  id         BigInt          @id @default(autoincrement())
  customerId BigInt
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  BigInt
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  BigInt?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@unique([customerId, productId, variantId])
}

model CompareItem {
  id         BigInt   @id @default(autoincrement())
  customerId BigInt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  BigInt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ============================================================
// ORDERS
// ============================================================

enum OrderStatus {
  PENDING
  PROCESSING
  ON_HOLD
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

model Cart {
  id               BigInt         @id @default(autoincrement())
  storeId          BigInt
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId       BigInt?
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  token            String         @unique
  items            CartItem[]
  appliedCouponId  BigInt?
  appliedCoupon    Coupon?        @relation(fields: [appliedCouponId], references: [id], onDelete: SetNull)
  couponDiscount   Decimal        @default(0) @db.Decimal(12, 2)
  giftCardCode     String?
  giftCardDiscount Decimal        @default(0) @db.Decimal(12, 2)
  currencyCode     String         @default("USD")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  abandoned        AbandonedCart?
  expiresAt        DateTime?

  @@index([customerId])
  @@index([storeId, createdAt])
}

model CartItem {
  id        BigInt          @id @default(autoincrement())
  cartId    BigInt
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId BigInt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId BigInt?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  lineTotal Decimal         @db.Decimal(12, 2)
  lineTax   Decimal         @default(0) @db.Decimal(12, 2)
  meta      Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([cartId, productId])
}

model Order {
  id                     BigInt               @id @default(autoincrement())
  storeId                BigInt
  store                  Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  number                 String               @unique
  customerId             BigInt?
  customer               Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNote           String?              @db.Text
  billingFirstName       String
  billingLastName        String
  billingCompany         String?
  billingAddress1        String
  billingAddress2        String?
  billingCity            String
  billingState           String?
  billingUpazila         String?
  billingPostcode        String?
  billingCountryCode     String
  billingEmail           String?
  billingPhone           String?
  shippingSameAsBilling  Boolean              @default(true)
  shippingFirstName      String?
  shippingLastName       String?
  shippingCompany        String?
  shippingAddress1       String?
  shippingAddress2       String?
  shippingCity           String?
  shippingState          String?
  shippingUpazila        String?
  /// Deepest Location picked for delivery (upazila/thana, else district).
  shippingLocationId     BigInt?
  shippingPostcode       String?
  shippingCountryCode    String?
  shippingPhone          String?
  itemsSubtotal          Decimal              @default(0) @db.Decimal(14, 2)
  discountTotal          Decimal              @default(0) @db.Decimal(14, 2)
  shippingTotal          Decimal              @default(0) @db.Decimal(14, 2)
  taxTotal               Decimal              @default(0) @db.Decimal(14, 2)
  feeTotal               Decimal              @default(0) @db.Decimal(14, 2)
  grandTotal             Decimal              @db.Decimal(14, 2)
  currencyCode           String
  exchangeRateToStore    Decimal              @default(1) @db.Decimal(12, 6)
  paymentGatewayCode     String
  transactionId          String?
  paymentStatus          String               @default("unpaid")
  paidAt                 DateTime?
  shippingZoneId         BigInt?
  shippingZone           ShippingZone?        @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  shippingMethodCode     String
  shippingMethodName     String
  trackingNumber         String?
  trackingUrl            String?
  estimatedDelivery      DateTime?
  status                 OrderStatus          @default(PENDING)
  /// From the parcels: unfulfilled | partial | packed | shipped | delivered | delivery_failed | returned
  fulfillmentStatus      String               @default("unfulfilled")
  /// From the latest return: none | requested | approved | received | refunded | rejected
  returnStatus           String               @default("none")
  refundedTotal          Decimal              @default(0) @db.Decimal(14, 2)
  statusHistory          OrderStatusLog[]
  isGuest                Boolean              @default(false)
  orderKey               String               @unique
  couponUsed             String?
  couponDiscountAmount   Decimal              @default(0) @db.Decimal(12, 2)
  /// Automatic promotions: their discount (part of discountTotal) and what applied, gifts included.
  promotionDiscount      Decimal              @default(0) @db.Decimal(12, 2)
  promotions             Json?
  /// Discount a staff member gave on a manual order (part of discountTotal).
  manualDiscount         Decimal              @default(0) @db.Decimal(12, 2)
  /// Loyalty level discount (part of discountTotal) and the level's name at the time.
  memberDiscount         Decimal              @default(0) @db.Decimal(12, 2)
  memberLevel            String?
  /// Paid from the customer's wallet; grandTotal is what's left to pay by the payment method.
  walletUsed             Decimal              @default(0) @db.Decimal(12, 2)
  /// The language the customer shopped in ("en" / "bn"): their invoice uses it.
  locale                 String               @default("en") @db.VarChar(5)
  /// Cashback credited when delivered (less any taken back after refunds).
  cashbackAmount         Decimal              @default(0) @db.Decimal(12, 2)
  cashbackAt             DateTime?
  /// The storefront the order was placed on (staff orders: the default storefront).
  storefrontId           BigInt?
  storefront             Storefront?          @relation(fields: [storefrontId], references: [id], onDelete: SetNull)
  /// Where the order came from: website, phone, facebook, instagram, whatsapp, messenger, walk_in, other.
  source                 String               @default("website")
  /// Warehouse the order ships from; its stock is reserved there until a parcel is packed.
  warehouseId            BigInt?
  warehouse              Warehouse?           @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  /// Staff member who created the order by hand (null for storefront orders).
  createdByAdminId       BigInt?
  createdByAdmin         AdminUser?           @relation("OrderCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  /// The salesperson the order is credited to (commission).
  salespersonId          BigInt?
  salesperson            AdminUser?           @relation("OrderSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  commission             SalesCommission?
  /// The landing page the order was placed on.
  landingPageId          BigInt?
  landingPage            LandingPage?         @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  giftCardUsed           String?
  giftCardDiscountAmount Decimal              @default(0) @db.Decimal(12, 2)
  supplierOrderId        String?
  supplierFulfilledAt    DateTime?
  items                  OrderItem[]
  shipments              Shipment[]
  refunds                Refund[]
  returns                ReturnRequest[]
  paymentAttempts        PaymentAttempt[]
  paymentRecords         PaymentRecord[]
  reviews                Review[]
  invoice                Invoice?
  giftCards              GiftCard[]
  giftCardRedemptions    GiftCardRedemption[]
  affiliateReferrals     AffiliateReferral[]
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  completedAt            DateTime?
  cancelledAt            DateTime?

  @@index([storeId, status])
  @@index([storeId, source])
  @@index([storeId, storefrontId])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([landingPageId])
}

model OrderStatusLog {
  id             BigInt      @id @default(autoincrement())
  orderId        BigInt
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         OrderStatus
  note           String?
  notifyCustomer Boolean     @default(false)
  adminId        BigInt?
  admin          AdminUser?  @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
}

model OrderItem {
  id               BigInt            @id @default(autoincrement())
  orderId          BigInt
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        BigInt?
  product          Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId        BigInt?
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName      String
  productSku       String?
  variantValues    Json?
  imageUrl         String?
  quantity         Int
  /// Cost of one unit when sold (from the product's cost price), for gross profit.
  unitCost         Decimal?          @db.Decimal(12, 2)
  unitPrice        Decimal           @db.Decimal(12, 2)
  lineSubtotal     Decimal           @db.Decimal(14, 2)
  lineTax          Decimal           @default(0) @db.Decimal(12, 2)
  lineDiscount     Decimal           @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal           @db.Decimal(14, 2)
  qtyShipped       Int               @default(0)
  /// Units still held for this line in the order's warehouse (not yet packed, cancelled or refunded).
  qtyReserved      Int               @default(0)
  qtyRefunded      Int               @default(0)
  downloadGranted  Boolean           @default(false)
  meta             Json?
  shipmentItems    ShipmentItem[]
  refundItems      RefundItem[]
  returnItems      ReturnItem[]
  digitalDownloads DigitalDownload[]
  createdAt        DateTime          @default(now())
}

/// A parcel handed to a courier (an order can go out in several).
model Shipment {
  id               BigInt          @id @default(autoincrement())
  storeId          BigInt
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId          BigInt
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "<order number>-P1", "-P2", ...
  code             String
  /// ready | picked_up | in_transit | out_for_delivery | delivered | failed | returned | cancelled
  status           String          @default("ready")
  /// Where it was packed; a cancelled or returned parcel's goods go back here.
  warehouseId      BigInt?
  warehouse        Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  providerCode     String
  providerName     String
  trackingNumber   String?
  trackingUrl      String?
  labelUrl         String?
  /// Cash the courier collects for this parcel.
  codAmount        Decimal         @default(0) @db.Decimal(14, 2)
  weightKg         Decimal?        @db.Decimal(8, 3)
  items            ShipmentItem[]
  events           ShipmentEvent[]
  paymentRecords   PaymentRecord[]
  /// Set once the parcel is booked with a courier through its API.
  courierAccountId BigInt?
  courierAccount   CourierAccount? @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  consignmentId    String?
  /// The courier's own status word (e.g. "in_review", "Assigned_for_Delivery") and latest message.
  courierStatus    String?
  courierMessage   String?
  bookedAt         DateTime?
  lastSyncedAt     DateTime?
  /// What the courier charges for this parcel, when it says.
  deliveryFee      Decimal?        @db.Decimal(12, 2)
  notes            String?
  failedReason     String?
  adminId          BigInt?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  returnedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([storeId, code])
  @@index([storeId, status])
  @@index([orderId])
  @@index([courierAccountId, consignmentId])
}

/// A store's account with a courier that has an API (Steadfast, Pathao, RedX).
model CourierAccount {
  id            BigInt       @id @default(autoincrement())
  storeId       BigInt
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// steadfast | pathao | redx
  courier       String
  label         String
  enabled       Boolean      @default(true)
  /// sandbox | live
  mode          String       @default("live")
  /// API keys and passwords as encrypted JSON (config/encryption.ts); never sent to the browser.
  credentials   String
  /// Non-secret options: Pathao store id, delivery type, item type; RedX pickup store; default weight.
  settings      Json?
  /// Part of the webhook URL given to the courier; identifies the account.
  webhookToken  String       @unique
  /// Encrypted secret the courier sends back (Steadfast Bearer token, Pathao X-PATHAO-Signature).
  webhookSecret String
  /// Encrypted access / refresh tokens (Pathao) and their expiry.
  tokenCache    String?
  lastCheckedAt DateTime?
  lastError     String?
  shipments     Shipment[]
  storefronts   Storefront[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([storeId, courier])
}

/// Money for an order that staff must check: a bKash/Nagad/bank transfer the customer reports
/// (kind "transfer"), or cash collected on delivery (kind "cod").
/// One try at paying an order online (bKash checkout, SSLCommerz). The order is only marked paid
/// after the gateway itself confirms the payment to the server (never from the browser's word).
model PaymentAttempt {
  id             BigInt         @id @default(autoincrement())
  storeId        BigInt
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId        BigInt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// bkash | sslcommerz
  gateway        String
  /// Our id for this try, sent to the gateway (SSLCommerz tran_id) and in return links.
  code           String         @unique
  /// The gateway's id for it (bKash paymentID, SSLCommerz sessionkey).
  reference      String?
  amount         Decimal        @db.Decimal(14, 2)
  /// sandbox | live
  mode           String
  /// started | paid | failed | cancelled | review (the gateway said paid but something didn't match)
  status         String         @default("started")
  /// The gateway's transaction id once paid (bKash trxID, SSLCommerz bank_tran_id).
  gatewayTxnId   String?
  /// Why it failed or needs a look.
  note           String?
  /// Where the customer goes back to on the storefront.
  returnUrl      String
  /// Money sent back through the gateway so far.
  refundedAmount Decimal        @default(0) @db.Decimal(14, 2)
  refunds        Refund[]
  events         PaymentEvent[]
  /// The gateway's last answer (no keys).
  raw            Json?
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([gateway, reference])
  @@index([orderId])
  @@index([storeId, status])
}

/// Everything a gateway sent us or answered about a try: the customer coming back, an IPN, a
/// staff re-check, a refund. Kept for checking disputes; keys and signatures are left out.
model PaymentEvent {
  id        BigInt          @id @default(autoincrement())
  storeId   BigInt
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attemptId BigInt?
  attempt   PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  gateway   String
  /// return | ipn | recheck | refund | refund_check
  source    String
  /// What we made of it: paid | failed | cancelled | pending | review | done | processing | error | unknown
  outcome   String
  note      String?
  /// What was received (form / query), without keys.
  payload   Json?
  ip        String?
  createdAt DateTime        @default(now())

  @@index([attemptId, createdAt])
  @@index([storeId, createdAt])
}

/// "Idempotency-Key" on requests that must not happen twice (placing an order, a refund): a repeat
/// with the same key gets the first answer back instead of doing it again. Kept for a day.
model IdempotencyKey {
  id           BigInt   @id @default(autoincrement())
  storeId      BigInt
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// What it's for (checkout, landing, refund) and the key the client sent.
  scope        String
  key          String
  /// A fingerprint of the request, so the same key can't be reused for a different one.
  requestHash  String
  /// working | done
  status       String   @default("working")
  responseCode Int?
  response     Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([storeId, scope, key])
  @@index([expiresAt])
}

model PaymentRecord {
  id            BigInt             @id @default(autoincrement())
  storeId       BigInt
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId       BigInt
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// transfer | cod
  kind          String
  /// bkash | nagad | rocket | bank_transfer | cod | cash
  method        String
  amount        Decimal            @db.Decimal(14, 2)
  transactionId String?
  /// The customer's wallet number or bank account the money came from.
  senderNumber  String?
  /// transfer: to_verify | verified | rejected
  /// cod: with_courier | cash_in_hand | received | not_collected
  status        String
  /// customer | courier | office | gateway
  moneyIsWith   String?
  /// cod: the parcel that collected it, and its courier.
  shipmentId    BigInt?
  shipment      Shipment?          @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  courierCode   String?
  courierName   String?
  settlementId  BigInt?
  settlement    CourierSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  /// customer | staff | system
  submittedBy   String             @default("customer")
  note          String?
  rejectReason  String?
  checkedById   BigInt?
  checkedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([storeId, kind, status])
  @@index([storeId, method, transactionId])
  @@index([orderId])
  @@index([settlementId])
}

/// A COD payout from a courier: the parcels it covers, what it should have been and what arrived.
model CourierSettlement {
  id             BigInt          @id @default(autoincrement())
  storeId        BigInt
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// "PAY-0001"
  code           String
  courierCode    String
  courierName    String
  /// Bank / mobile transfer reference of the payout.
  reference      String?
  paidOn         DateTime
  /// Sum of the parcels' cash.
  expectedAmount Decimal         @db.Decimal(14, 2)
  /// Delivery and COD charges the courier kept.
  charges        Decimal         @default(0) @db.Decimal(14, 2)
  receivedAmount Decimal         @db.Decimal(14, 2)
  /// expected - charges - received (positive = courier paid too little)
  shortfall      Decimal         @default(0) @db.Decimal(14, 2)
  /// balanced | short | over | resolved
  status         String
  note           String?
  resolvedNote   String?
  adminId        BigInt?
  records        PaymentRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([storeId, code])
  @@index([storeId, courierCode])
  @@index([storeId, status])
}

model ShipmentEvent {
  id         BigInt   @id @default(autoincrement())
  shipmentId BigInt
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  adminId    BigInt?
  createdAt  DateTime @default(now())

  @@index([shipmentId])
}

model ShipmentItem {
  id          BigInt    @id @default(autoincrement())
  shipmentId  BigInt
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId BigInt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
}

model Invoice {
  id        BigInt   @id @default(autoincrement())
  orderId   BigInt   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  number    String   @unique
  pdfUrl    String?
  data      Json?
  createdAt DateTime @default(now())
}

model Refund {
  id                   BigInt          @id @default(autoincrement())
  storeId              BigInt
  store                Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId              BigInt
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId              BigInt?
  admin                AdminUser?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  reason               String
  items                RefundItem[]
  amount               Decimal         @db.Decimal(14, 2)
  /// original | cash | bkash | nagad | bank | store_credit
  method               String          @default("original")
  returnRequestId      BigInt?
  returnRequest        ReturnRequest?  @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  restockItems         Boolean         @default(true)
  gatewayRefunded      Boolean         @default(false)
  gatewayTransactionId String?
  /// The online payment it went back to (bKash / SSLCommerz), when refunded through the gateway.
  paymentAttemptId     BigInt?
  paymentAttempt       PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  /// done | processing (SSLCommerz is still sending it) | null (not through a gateway)
  gatewayStatus        String?
  /// The gateway's refund id (bKash refundTrxID, SSLCommerz refund_ref_id) or what it said.
  gatewayNote          String?
  noteToCustomer       String?         @db.Text
  status               String          @default("completed")
  createdAt            DateTime        @default(now())
}

model RefundItem {
  id          BigInt    @id @default(autoincrement())
  refundId    BigInt
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItemId BigInt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity    Int
  amount      Decimal   @db.Decimal(12, 2)
}

model ReturnRequest {
  id               BigInt        @id @default(autoincrement())
  storeId          BigInt
  store            Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId          BigInt
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId       BigInt?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type             String        @default("return")
  reason           String
  customerNote     String?       @db.Text
  items            ReturnItem[]
  events           ReturnEvent[]
  /// "<order number>-R1", ...
  code             String?
  requestedAmount  Decimal       @db.Decimal(14, 2)
  /// requested | approved | received | refunded | rejected | cancelled
  status           String        @default("requested")
  /// Who asked: "customer" (storefront) or "staff".
  requestedBy      String        @default("customer")
  approvedAt       DateTime?
  receivedAt       DateTime?
  closedAt         DateTime?
  refunds          Refund[]
  resolution       String?
  resolutionAmount Decimal?      @db.Decimal(14, 2)
  adminNotes       String?       @db.Text
  trackingNumber   String?
  returnLabelUrl   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([storeId, status])
}

model ReturnItem {
  id               BigInt        @id @default(autoincrement())
  returnRequestId  BigInt
  returnRequest    ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId      BigInt
  orderItem        OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity         Int
  condition        String?
  customerPhotos   Json?
  resolutionAmount Decimal?      @db.Decimal(12, 2)
  /// Put back into stock when the return was received.
  restocked        Boolean       @default(false)
}

model ReturnEvent {
  id              BigInt        @id @default(autoincrement())
  returnRequestId BigInt
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  status          String
  note            String?
  adminId         BigInt?
  createdAt       DateTime      @default(now())

  @@index([returnRequestId])
}

model AbandonedCart {
  id                BigInt    @id @default(autoincrement())
  storeId           BigInt
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cartId            BigInt    @unique
  cart              Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customerEmail     String?
  firstName         String?
  recoveryToken     String    @unique
  recoveryUrl       String
  reminderSentAt    DateTime?
  reminderSentCount Int       @default(0)
  recoveredAt       DateTime?
  totalAmount       Decimal   @db.Decimal(14, 2)
  createdAt         DateTime  @default(now())

  @@index([storeId, createdAt])
}

// ============================================================
// MARKETING
// ============================================================

enum DiscountType {
  PERCENTAGE
  FIXED_CART
  FIXED_PRODUCT
  BOGO
  FREE_SHIPPING
}

model Coupon {
  id                  BigInt       @id @default(autoincrement())
  storeId             BigInt
  store               Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code                String
  description         String?
  type                DiscountType
  amount              Decimal      @db.Decimal(12, 2)
  freeShipping        Boolean      @default(false)
  minSubtotal         Decimal?     @db.Decimal(12, 2)
  maxSubtotal         Decimal?     @db.Decimal(12, 2)
  productIds          Json?
  excludeProductIds   Json?
  categoryIds         Json?
  excludeSales        Boolean      @default(false)
  individualOnly      Boolean      @default(false)
  customerGroupIds    Json?
  customerEmails      Json?
  newCustomersOnly    Boolean      @default(false)
  totalUsageLimit     Int?
  perCustomerLimit    Int?
  usageCount          Int          @default(0)
  startsAt            DateTime?
  expiresAt           DateTime?
  isActive            Boolean      @default(true)
  autoApply           Boolean      @default(false)
  rewardType          String?
  rewardValue         Json?
  /// private = typed code; public = listed in the cart for anyone to use; given = only the customerEmails.
  audience            String       @default("private")
  /// Off: no automatic promotion on the order and flash-sale items don't count toward this coupon.
  worksWithPromotions Boolean      @default(true)
  /// Only on these storefronts (empty: all).
  storefrontIds       BigInt[]     @default([])
  appliedCarts        Cart[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([storeId, code])
  @@index([storeId, isActive])
}

/// Automatic (code-free) offers: discount, free gift over a spend, buy X get Y free, free delivery.
/// Rules live in modules/marketing/promotions.rules.ts.
model Promotion {
  id               BigInt    @id @default(autoincrement())
  storeId          BigInt
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name             String
  /// discount | free_gift | bxgy | free_delivery
  type             String
  /// percentage | fixed (discount only)
  discountType     String?
  discountValue    Decimal?  @db.Decimal(12, 2)
  /// Largest discount for a percentage offer.
  maxDiscount      Decimal?  @db.Decimal(12, 2)
  minOrder         Decimal?  @db.Decimal(12, 2)
  minQty           Int?
  /// Scope: products or whole categories; both empty = the whole cart.
  productIds       BigInt[]  @default([])
  categoryIds      BigInt[]  @default([])
  /// Flash-sale / marked-down items count and get discounted too.
  includeSaleItems Boolean   @default(false)
  /// bxgy: buy `buyQty` of one product, get `getQty` more of it free.
  buyQty           Int?
  getQty           Int?
  /// free_gift: the product (and option) added at no charge.
  giftProductId    BigInt?
  giftVariantId    BigInt?
  giftQty          Int       @default(1)
  /// Where the storefront shows it (announcement_bar, home_hero, cart, …) and what it says.
  slots            String[]  @default([])
  /// Only on these storefronts (empty: all).
  storefrontIds    BigInt[]  @default([])
  headline         String?
  message          String?
  imageUrl         String?
  linkUrl          String?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean   @default(true)
  /// Orders it applied to (counted when the order is placed).
  usedCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([storeId, isActive])
}

model FlashSale {
  id              BigInt          @id @default(autoincrement())
  storeId         BigInt
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  description     String?
  startsAt        DateTime
  endsAt          DateTime
  discountPercent Decimal?        @db.Decimal(5, 2)
  discountFixed   Decimal?        @db.Decimal(12, 2)
  rules           Json?
  bannerImageUrl  String?
  bannerTitle     String?
  bannerSubtitle  String?
  bannerCtaText   String?
  bannerCtaUrl    String?
  position        Int             @default(0)
  isActive        Boolean         @default(true)
  items           FlashSaleItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([storeId, slug])
}

model FlashSaleItem {
  id          BigInt          @id @default(autoincrement())
  flashSaleId BigInt
  flashSale   FlashSale       @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId   BigInt
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   BigInt?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  salePrice   Decimal?        @db.Decimal(12, 2)
  discountPct Decimal?        @db.Decimal(5, 2)
  stockLimit  Int?
  soldCount   Int             @default(0)
  sortOrder   Int             @default(0)

  @@unique([flashSaleId, productId, variantId])
}

model Banner {
  id              BigInt    @id @default(autoincrement())
  storeId         BigInt
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type            String
  name            String
  title           String?
  subtitle        String?
  description     String?   @db.Text
  imageUrl        String?
  mobileImageUrl  String?
  videoUrl        String?
  ctaText         String?
  ctaUrl          String?
  ctaOpenNewTab   Boolean   @default(false)
  bannerStyle     Json?
  placement       String?
  scheduleStart   DateTime?
  scheduleEnd     DateTime?
  visibilityRules Json?
  status          String    @default("active")
  sortOrder       Int       @default(0)
  clicks          Int       @default(0)
  impressions     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GiftCard {
  id             BigInt               @id @default(autoincrement())
  storeId        BigInt
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code           String
  name           String?
  initialBalance Decimal              @db.Decimal(12, 2)
  remaining      Decimal              @db.Decimal(12, 2)
  isVirtual      Boolean              @default(true)
  recipientEmail String?
  recipientName  String?
  senderName     String?
  message        String?              @db.Text
  imageUrl       String?
  orderId        BigInt?
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId     BigInt?
  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  expiresAt      DateTime?
  isActive       Boolean              @default(true)
  redemptions    GiftCardRedemption[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([storeId, code])
}

model GiftCardRedemption {
  id         BigInt    @id @default(autoincrement())
  giftCardId BigInt
  giftCard   GiftCard  @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  orderId    BigInt
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId BigInt?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  amount     Decimal   @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
}

model Affiliate {
  id                BigInt              @id @default(autoincrement())
  storeId           BigInt
  store             Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId        BigInt              @unique
  customer          Customer            @relation("CustomerAffiliateProfile", fields: [customerId], references: [id], onDelete: Cascade)
  referredCustomers Customer[]          @relation("AffiliateReferredCustomers")
  referralCode      String              @unique
  referralUrl       String
  commissionType    String              @default("percent")
  commissionRate    Decimal             @db.Decimal(12, 2)
  paypalEmail       String?
  bankDetails       Json?
  balance           Decimal             @default(0) @db.Decimal(14, 2)
  totalEarned       Decimal             @default(0) @db.Decimal(14, 2)
  totalPaid         Decimal             @default(0) @db.Decimal(14, 2)
  status            String              @default("active")
  referrals         AffiliateReferral[]
  payouts           AffiliatePayout[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([storeId, referralCode])
}

model AffiliateReferral {
  id                 BigInt    @id @default(autoincrement())
  affiliateId        BigInt
  affiliate          Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredCustomerId BigInt?
  referredCustomer   Customer? @relation("CustomerReferrals", fields: [referredCustomerId], references: [id], onDelete: SetNull)
  orderId            BigInt?
  order              Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  commission         Decimal   @default(0) @db.Decimal(12, 2)
  status             String    @default("pending")
  convertedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([affiliateId])
}

model AffiliatePayout {
  id          BigInt    @id @default(autoincrement())
  affiliateId BigInt
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 2)
  method      String
  status      String    @default("pending")
  reference   String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
}

