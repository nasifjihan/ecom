// ============================================================
// DROPSHIPPING & SUPPLIERS (Optional Module)
// ============================================================
model Supplier {
  id                   BigInt            @id @default(autoincrement())
  storeId              BigInt
  store                Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  contactEmail         String?
  contactPhone         String?
  /// What the shop already owed when it started using the app (negative = supplier owes us / advance).
  openingBalance       Decimal           @default(0) @db.Decimal(12, 2)
  notes                String?
  purchases            Purchase[]
  payments             SupplierPayment[]
  contactPerson        String?
  address              String?
  countryCode          String?
  apiConfig            Json?
  fulfillmentEmail     String?
  orderAutoForward     Boolean           @default(false)
  markupStrategy       String?
  markupPercentDefault Decimal?          @db.Decimal(5, 2)
  status               String            @default("active")
  products             Product[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([storeId, slug])
}

/// Stock bought from a supplier: received at once, updating stock and cost prices. modules/purchasing
model Purchase {
  id               BigInt            @id @default(autoincrement())
  storeId          BigInt
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  /// PUR-000001
  number           String
  supplierId       BigInt
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// local | import
  sourcingType     String            @default("local")
  originCountry    String?
  sourceFrom       String?
  /// The supplier's invoice or reference number.
  reference        String?
  /// Warehouse the goods were received into.
  warehouseId      BigInt?
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  purchasedOn      DateTime          @db.Date
  itemsSubtotal    Decimal           @db.Decimal(12, 2)
  shippingCost     Decimal           @default(0) @db.Decimal(12, 2)
  customsDuty      Decimal           @default(0) @db.Decimal(12, 2)
  otherCharges     Decimal           @default(0) @db.Decimal(12, 2)
  discount         Decimal           @default(0) @db.Decimal(12, 2)
  /// Items + shipping + customs + other − discount: what the stock cost in all.
  total            Decimal           @db.Decimal(12, 2)
  /// advance | instant_full | instant_partial | credit
  paymentTerm      String
  /// received | cancelled
  status           String            @default("received")
  notes            String?
  createdByAdminId BigInt?
  cancelledAt      DateTime?
  items            PurchaseItem[]
  payments         SupplierPayment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, number])
  @@index([storeId, purchasedOn])
  @@index([supplierId])
}

model PurchaseItem {
  id             BigInt          @id @default(autoincrement())
  purchaseId     BigInt
  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId      BigInt
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      BigInt?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  /// Snapshot for the record, e.g. "Cotton Panjabi (M / White)".
  name           String
  qualityGrade   String?
  qty            Int
  unitCost       Decimal         @db.Decimal(12, 2)
  discountPct    Decimal         @default(0) @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal         @db.Decimal(12, 2)
  /// Unit cost with its share of shipping, customs, other charges and discount.
  landedUnitCost Decimal         @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

/// Money paid to a supplier, from one of the shop's accounts.
model SupplierPayment {
  id               BigInt       @id @default(autoincrement())
  storeId          BigInt
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierId       BigInt
  supplier         Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseId       BigInt?
  purchase         Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  accountId        BigInt
  account          MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount           Decimal      @db.Decimal(12, 2)
  /// cash | bank_transfer | cheque | bkash | nagad | rocket | other
  method           String
  paidOn           DateTime     @db.Date
  reference        String?
  notes            String?
  createdByAdminId BigInt?
  createdAt        DateTime     @default(now())

  @@index([storeId, paidOn])
  @@index([supplierId])
}

/// The shop's bank, cash and mobile-wallet accounts. Balance = opening balance + its transactions.
model MoneyAccount {
  id             BigInt             @id @default(autoincrement())
  storeId        BigInt
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  /// bank | cash | mobile
  type           String
  details        String?
  openingBalance Decimal            @default(0) @db.Decimal(12, 2)
  isActive       Boolean            @default(true)
  transactions   MoneyTransaction[]
  payments       SupplierPayment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([storeId])
}

/// One movement of money in an account: + in, − out. Never edited; a mistake is corrected by another entry.
model MoneyTransaction {
  id               BigInt       @id @default(autoincrement())
  storeId          BigInt
  store            Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accountId        BigInt
  account          MoneyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount           Decimal      @db.Decimal(12, 2)
  /// supplier_payment | deposit | withdrawal | transfer_in | transfer_out | adjustment | reversal
  kind             String
  refType          String?
  refId            String?
  note             String?
  occurredOn       DateTime     @db.Date
  createdByAdminId BigInt?
  createdAt        DateTime     @default(now())

  @@index([accountId, occurredOn])
  @@index([storeId, occurredOn])
}

/// Grades a shop buys stock in (Genuine, Copy 1, Stock Lot…), picked on purchase lines.
model QualityGrade {
  id        BigInt @id @default(autoincrement())
  storeId   BigInt
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  @@unique([storeId, name])
}

// ============================================================
// SUBSCRIPTIONS (Optional Module)
// ============================================================
model SubscriptionProduct {
  id                    BigInt                 @id @default(autoincrement())
  storeId               BigInt
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId             BigInt                 @unique
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  interval              String
  intervalCount         Int                    @default(1)
  trialDays             Int                    @default(0)
  signupFee             Decimal                @default(0) @db.Decimal(12, 2)
  maxCycles             Int?
  cancelAnytime         Boolean                @default(true)
  prorateOnChange       Boolean                @default(true)
  customerSubscriptions CustomerSubscription[]
  createdAt             DateTime               @default(now())
}

model CustomerSubscription {
  id                    BigInt              @id @default(autoincrement())
  storeId               BigInt
  store                 Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId            BigInt
  customer              Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionProductId BigInt
  subscriptionProduct   SubscriptionProduct @relation(fields: [subscriptionProductId], references: [id])
  productId             BigInt
  product               Product             @relation(fields: [productId], references: [id])
  variantId             BigInt?
  variant               ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity              Int
  recurringPrice        Decimal             @db.Decimal(12, 2)
  signupFeePaid         Decimal             @default(0) @db.Decimal(12, 2)
  totalPaid             Decimal             @default(0) @db.Decimal(14, 2)
  status                String              @default("active")
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  cancelledAt           DateTime?
  endsAt                DateTime?
  nextChargeAt          DateTime?
  paymentMethodToken    String?
  gatewayCustomerId     String?
  failedPaymentAttempts Int                 @default(0)
  dunningRetriesLeft    Int                 @default(3)
  relatedOrders         Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([storeId, customerId])
  @@index([status])
  @@index([nextChargeAt])
}

// ============================================================
// DIGITAL DOWNLOADS (granted after payment)
// ============================================================
model DigitalDownload {
  id            BigInt    @id @default(autoincrement())
  storeId       BigInt
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId    BigInt
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItemId   BigInt
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  fileId        BigInt
  file          MediaFile @relation(fields: [fileId], references: [id])
  downloadKey   String    @unique
  downloadsLeft Int?
  expiresAt     DateTime?
  lastDownload  DateTime?
  createdAt     DateTime  @default(now())
}

// ============================================================
// INTEGRATIONS
