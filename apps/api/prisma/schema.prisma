  storeId         BigInt
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  folderId        BigInt?
  folder          MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  filename        String
  originalName    String
  mimeType        String
  sizeBytes       BigInt
  url             String
  thumbUrl        String?
  width           Int?
  height          Int?
  altText         String?
  caption         String?
  kind            String
  metadata        Json?
  uploadedByType  String
  uploadedById    BigInt
  productsDigital Product[]         @relation("ProductDigitalFile")
