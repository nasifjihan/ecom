{
  "name": "@ecom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/index.ts",
    "couriers:mock": "node scripts/mock-couriers.mjs",
    "payments:mock": "node scripts/mock-payments.mjs",
    "sms:mock": "node scripts/mock-sms.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --port 5555"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@ecom/export-utils": "workspace:*",
    "@ecom/shared-types": "workspace:^",
    "@ecom/utils": "workspace:*",
    "@ecom/zod-schemas": "workspace:*",
    "@paralleldrive/cuid2": "^2.3.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-writer": "^1.6.0",
    "dotenv": "^17.4.2",
    "eventemitter2": "^6.4.9",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "express-slow-down": "^2.1.0",
    "handlebars": "^4.7.9",
    "harfbuzzjs": "1.6.2",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "2.3.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^10.0.7",
    "pdfkit": "^0.20.2",
    "pdfkit-table": "^0.2.11",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect": "^3.4.38",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.1",
    "pino-http": "^10.5.0",
    "pino-pretty": "11.3.0",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  }
}
